class Solution:
    def is_in_place(self, arr, dist, k):
        cows_count = 1
        last_cow = arr[0]

        for i in range(1, len(arr)):
            if arr[i] - last_cow >= dist:
                cows_count += 1
                last_cow = arr[i]

                if cows_count >= k:
                    return True

        return False

    def aggressiveCows(self, arr, k):
        arr.sort()

        low = 0
        high = arr[-1] - arr[0]
        ans = 0

        while low <= high:
            mid = (low + high) // 2

            if self.is_in_place(arr, mid, k):
                ans = mid
                low = mid + 1
            else:
                high = mid - 1

        return ans
