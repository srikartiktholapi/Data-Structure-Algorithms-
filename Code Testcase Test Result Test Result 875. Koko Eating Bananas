import math
from typing import List

class Solution:
    def total_hours(self, piles, speed):
        total_hours = 0
        for pile in piles:
            total_hours += math.ceil(pile / speed)
        return total_hours

    # Brute Force - O(n * maxPile)
    def minEatingSpeed_brute(self, piles: List[int], h: int) -> int:
        maxval = max(piles)
        for speed in range(1, maxval + 1):
            if self.total_hours(piles, speed) <= h:
                return speed
        return maxval

    # Optimal - Binary Search - O(n * log(maxPile))
    def minEatingSpeed(self, piles: List[int], h: int) -> int:
        low = 1
        high = max(piles)
        ans = high
        while low <= high:
            mid = (low + high) // 2
            if self.total_hours(piles, mid) <= h:
                ans = mid
                high = mid - 1
            else:
                low = mid + 1
        return ans
