class Solution:
    def is_possible(self,max_sum,nums,k):
        partitions = 1
        subarray_sum = 0 
        for num in nums :
            if subarray_sum + num > max_sum :
                partitions +=1
                subarray_sum = num
            else :
                subarray_sum += num
        if partitions > k :
            return False 
        else :
            return True 
    def splitArray(self, nums: List[int], k: int) -> int:
        low = max(nums)
        high = sum(nums)
        while low<=high:
            mid = (low+high)//2
            if self.is_possible(mid,nums,k):
                ans = mid 
                high = mid - 1
            else :
                low = mid + 1
        return ans 
        
