class Solution:
    def generate(self, numRows: int) -> List[List[int]]:

        traingle = []

        for i in range(numRows):
            row =[1]*(i+1)

            for j in range(1,i):
                row[j]=traingle[i-1][j-1]+traingle[i-1][j]
            traingle.append(row)
        
        return traingle 
